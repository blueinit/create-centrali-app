# ─── Centrali server-side credentials (service account) ──────────────
#
# This template uses ONE credential path: a server-side service account.
# Every Centrali call runs in a server component or route handler, so these
# values never reach the browser. Do NOT prefix them with NEXT_PUBLIC_ —
# that would embed your client secret in the JavaScript bundle.
#
# Copy this file to .env.local and fill in the values, or run:
#   npx @centrali-io/create-centrali-app env
#
# Create a service account in Console > ACCESS > Service Accounts, then add
# it to the workspace_administrators or workspace_developers group so it can
# create collections.

# Centrali base URL. Use the root domain — the SDK derives api.<domain> itself.
CENTRALI_API_URL=https://centrali.io

# Your workspace slug (Console > Settings). This is the slug, not the display name.
CENTRALI_WORKSPACE=your-workspace-slug

# Service account credentials
CENTRALI_CLIENT_ID=sa_your_client_id
CENTRALI_CLIENT_SECRET=sk_your_client_secret

# ─── Not used by this template ───────────────────────────────────────
#
# A publishable key (NEXT_PUBLIC_CENTRALI_PK) lets browser code read
# collections and, with an explicit per-slug scope, create records. It can
# never create a collection, which is this template's first step — so the
# template does not use one. Add it deliberately when you decide which
# collections and actions to expose to the browser:
# https://docs.centrali.io/authentication/
